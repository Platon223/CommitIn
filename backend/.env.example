# Copy to backend/.env and fill in. backend/.env is gitignored.

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=commitin

# Database name inside the cluster.
MONGO_DB=commitin

# Port the HTTP server listens on.
PORT=8080
